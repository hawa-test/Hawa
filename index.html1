<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Gaemhup - ألعاب واختبارات ممتعة للشخصية والذكاء والحب والأصدقاء">
<title>Gaemhup | اختبارات وألعاب</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap');

*{box-sizing:border-box;margin:0;padding:0}

:root{
 --bg:#08030f;
 --bg2:#130722;
 --purple:#8b5cf6;
 --purple2:#c026d3;
 --pink:#ec4899;
 --text:#fff;
 --muted:#b9abc5;
 --glass:rgba(255,255,255,.07);
 --border:rgba(255,255,255,.13);
}

html{scroll-behavior:smooth}

body{
 font-family:Cairo,Arial,sans-serif;
 background:
 radial-gradient(circle at 10% 10%,#6d28d933,transparent 30%),
 radial-gradient(circle at 90% 20%,#c026d333,transparent 30%),
 radial-gradient(circle at 50% 100%,#7c3aed22,transparent 35%),
 var(--bg);
 color:var(--text);
 min-height:100vh;
 overflow-x:hidden;
}

/* النجوم */
body:before{
 content:"";
 position:fixed;
 inset:0;
 pointer-events:none;
 opacity:.35;
 background-image:
 radial-gradient(#fff 1px,transparent 1px),
 radial-gradient(#fff 1px,transparent 1px);
 background-size:80px 80px,120px 120px;
 background-position:10px 20px,50px 70px;
 animation:stars 18s linear infinite;
}
@keyframes stars{
 from{transform:translateY(0)}
 to{transform:translateY(-100px)}
}

header{
 position:sticky;
 top:0;
 z-index:100;
 padding:15px 6%;
 display:flex;
 align-items:center;
 justify-content:space-between;
 background:rgba(8,3,15,.72);
 backdrop-filter:blur(20px);
 border-bottom:1px solid var(--border);
}

.logo{
 font-size:25px;
 font-weight:900;
 letter-spacing:-1px;
}
.logo span{
 background:linear-gradient(90deg,#a78bfa,#f0abfc,#f472b6);
 -webkit-background-clip:text;
 color:transparent;
}

nav{
 display:flex;
 gap:25px;
}
nav a{
 color:#ddd;
 text-decoration:none;
 font-weight:700;
 transition:.3s;
}
nav a:hover{color:#c084fc}

.menu{
 display:none;
 font-size:25px;
 cursor:pointer;
}

.hero{
 position:relative;
 min-height:650px;
 display:flex;
 align-items:center;
 justify-content:center;
 text-align:center;
 padding:80px 20px;
 overflow:hidden;
}

.orb{
 position:absolute;
 border-radius:50%;
 filter:blur(4px);
 animation:float 7s ease-in-out infinite;
}
.orb.one{
 width:280px;height:280px;
 background:#7c3aed33;
 top:80px;right:5%;
}
.orb.two{
 width:220px;height:220px;
 background:#db277733;
 bottom:40px;left:8%;
 animation-delay:2s;
}
@keyframes float{
 0%,100%{transform:translate(0,0)}
 50%{transform:translate(20px,-30px)}
}

.hero-content{
 position:relative;
 z-index:2;
 max-width:850px;
}

.badge{
 display:inline-block;
 padding:8px 17px;
 border:1px solid #c084fc55;
 border-radius:50px;
 background:#ffffff08;
 color:#d8b4fe;
 margin-bottom:20px;
 box-shadow:0 0 30px #8b5cf622;
}

.hero h1{
 font-size:clamp(48px,9vw,90px);
 line-height:1;
 margin-bottom:25px;
 font-weight:900;
 background:linear-gradient(
  90deg,#fff,#d8b4fe,#a78bfa,#f0abfc,#fff
 );
 background-size:250%;
 -webkit-background-clip:text;
 color:transparent;
 animation:gradient 5s linear infinite;
}
@keyframes gradient{
 to{background-position:250%}
}

.hero p{
 color:var(--muted);
 font-size:19px;
 line-height:2;
 max-width:650px;
 margin:0 auto 30px;
}

.buttons{
 display:flex;
 gap:14px;
 justify-content:center;
 flex-wrap:wrap;
}

.btn{
 border:0;
 cursor:pointer;
 padding:14px 28px;
 border-radius:50px;
 color:#fff;
 font-family:inherit;
 font-weight:800;
 font-size:15px;
 background:linear-gradient(100deg,#7c3aed,#c026d3,#ec4899);
 background-size:200%;
 box-shadow:0 10px 35px #8b5cf644;
 transition:.3s;
}
.btn:hover{
 transform:translateY(-4px) scale(1.03);
 box-shadow:0 15px 45px #c026d366;
 background-position:100%;
}

.btn.secondary{
 background:#ffffff0a;
 border:1px solid var(--border);
 box-shadow:none;
}

.ad{
 width:min(900px,90%);
 height:90px;
 margin:20px auto 60px;
 border:1px dashed #ffffff25;
 border-radius:20px;
 display:flex;
 align-items:center;
 justify-content:center;
 color:#766b82;
 background:#ffffff03;
}

/* الألعاب */
.container{
 width:min(1200px,92%);
 margin:auto;
}

.section-title{
 text-align:center;
 margin-bottom:40px;
}

.section-title small{
 color:#c084fc;
 font-weight:800;
}

.section-title h2{
 font-size:38px;
 margin-top:8px;
}

.section-title p{
 color:var(--muted);
 margin-top:8px;
}

.games{
 display:grid;
 grid-template-columns:repeat(3,1fr);
 gap:22px;
}

.card{
 position:relative;
 overflow:hidden;
 padding:28px;
 min-height:245px;
 border-radius:28px;
 border:1px solid var(--border);
 background:
 linear-gradient(145deg,rgba(255,255,255,.10),rgba(255,255,255,.035));
 backdrop-filter:blur(18px);
 cursor:pointer;
 transition:.4s;
}

.card:before{
 content:"";
 position:absolute;
 width:130px;
 height:130px;
 border-radius:50%;
 background:#8b5cf633;
 filter:blur(30px);
 top:-50px;
 left:-50px;
 transition:.4s;
}

.card:hover{
 transform:translateY(-10px) rotateX(2deg);
 border-color:#c084fc66;
 box-shadow:0 25px 60px #0007,0 0 30px #8b5cf622;
}

.card:hover:before{
 transform:scale(1.5);
}

.card-icon{
 position:relative;
 font-size:48px;
 margin-bottom:15px;
}

.card h3{
 position:relative;
 font-size:21px;
 margin-bottom:9px;
}

.card p{
 position:relative;
 color:var(--muted);
 line-height:1.8;
 font-size:14px;
}

.play{
 position:absolute;
 bottom:22px;
 left:25px;
 color:#c084fc;
 font-weight:800;
}

/* عن الموقع */
.about{
 margin:100px 0;
 padding:45px;
 border:1px solid var(--border);
 border-radius:30px;
 background:linear-gradient(135deg,#ffffff0b,#ffffff03);
 text-align:center;
}

.about h2{font-size:32px;margin-bottom:15px}
.about p{
 color:var(--muted);
 line-height:2;
 max-width:800px;
 margin:auto;
}

/* الفوتر */
footer{
 margin-top:80px;
 padding:45px 20px;
 border-top:1px solid var(--border);
 text-align:center;
 color:#81768c;
}

/* المودال */
.modal{
 position:fixed;
 inset:0;
 z-index:500;
 display:none;
 align-items:center;
 justify-content:center;
 padding:20px;
 background:#000b;
 backdrop-filter:blur(12px);
}

.modal.active{
 display:flex;
 animation:fade .25s;
}

@keyframes fade{
 from{opacity:0}
 to{opacity:1}
}

.modal-box{
 width:min(620px,100%);
 max-height:90vh;
 overflow:auto;
 background:
 radial-gradient(circle at top,#7c3aed22,transparent 45%),
 #150a21;
 border:1px solid #ffffff1c;
 border-radius:30px;
 padding:30px;
 box-shadow:0 30px 100px #000;
 animation:pop .35s;
}

@keyframes pop{
 from{transform:scale(.85);opacity:0}
 to{transform:scale(1);opacity:1}
}

.close{
 float:left;
 width:38px;
 height:38px;
 border-radius:50%;
 border:1px solid var(--border);
 background:#ffffff08;
 color:white;
 cursor:pointer;
 font-size:24px;
}

.game-title{
 text-align:center;
 font-size:29px;
 margin:15px 0 25px;
}

.question{
 font-size:20px;
 font-weight:800;
 text-align:center;
 line-height:1.8;
 margin-bottom:20px;
}

.options{
 display:grid;
 gap:10px;
}

.option{
 width:100%;
 padding:15px;
 border-radius:16px;
 border:1px solid var(--border);
 background:#ffffff08;
 color:white;
 font-family:inherit;
 cursor:pointer;
 font-weight:700;
 transition:.25s;
}

.option:hover{
 background:linear-gradient(90deg,#7c3aed55,#c026d355);
 border-color:#c084fc66;
 transform:translateX(-4px);
}

.progress{
 height:7px;
 background:#ffffff0c;
 border-radius:10px;
 overflow:hidden;
 margin-bottom:25px;
}
.progress span{
 display:block;
 height:100%;
 background:linear-gradient(90deg,#7c3aed,#ec4899);
 transition:.3s;
}

.result{
 text-align:center;
 padding:20px 5px;
}

.result-icon{
 font-size:70px;
 margin-bottom:15px;
}

.result h3{
 font-size:28px;
 margin-bottom:12px;
}

.result p{
 color:var(--muted);
 line-height:2;
}

.percent{
 font-size:65px;
 font-weight:900;
 background:linear-gradient(90deg,#a78bfa,#f0abfc,#f472b6);
 -webkit-background-clip:text;
 color:transparent;
 margin:10px;
}

input{
 width:100%;
 padding:15px;
 border-radius:15px;
 border:1px solid var(--border);
 background:#ffffff08;
 color:#fff;
 font-family:inherit;
 outline:none;
 margin-bottom:12px;
}

input:focus{border-color:#a78bfa}

.form-group{
 margin-bottom:10px;
}

.form-label{
 display:block;
 color:#cfc3d6;
 margin-bottom:7px;
 font-size:14px;
}

.reaction-area{
 height:230px;
 border-radius:25px;
 background:#ffffff06;
 border:1px solid var(--border);
 display:flex;
 align-items:center;
 justify-content:center;
 margin-bottom:20px;
 cursor:pointer;
 user-select:none;
 font-size:23px;
 font-weight:900;
}

.reaction-area.ready{
 background:#22c55e22;
 border-color:#22c55e88;
}

.note{
 text-align:center;
 color:#776b82;
 font-size:12px;
 margin-top:15px;
}

@media(max-width:900px){
 .games{grid-template-columns:repeat(2,1fr)}
}

@media(max-width:600px){
 header{padding:14px 5%}
 nav{display:none}
 .menu{display:block}
 .hero{min-height:580px;padding-top:50px}
 .hero h1{font-size:57px}
 .hero p{font-size:16px}
 .games{grid-template-columns:1fr}
 .section-title h2{font-size:30px}
 .about{padding:28px 20px}
 .modal-box{padding:22px}
}
</style>
</head>

<body>

<header>
 <div class="logo">Gaem<span>hup</span> ✦</div>

 <nav>
  <a href="#games">الألعاب</a>
  <a href="#about">عن الموقع</a>
 </nav>

 <div class="menu">☰</div>
</header>

<section class="hero">

 <div class="orb one"></div>
 <div class="orb two"></div>

 <div class="hero-content">

  <div class="badge">✨ مكانك للمتعة والتحديات</div>

  <h1>Gaemhup</h1>

  <p>
   اختبارات ممتعة تكشف شخصيتك،
   تحديات للأصدقاء، ذكاء، حب وتوافق...
   <br>
   <b>جاهز تعرف النتيجة؟ 👀</b>
  </p>

  <div class="buttons">
   <a href="#games" class="btn">ابدأ الآن ✨</a>
   <a href="#about" class="btn secondary">اكتشف الموقع</a>
  </div>

 </div>
</section>

<div class="ad">
 📢 مساحة إعلانية
</div>

<main class="container" id="games">

 <div class="section-title">
  <small>اختباراتنا</small>
  <h2>🎮 اختر تحديك</h2>
  <p>اضغط على أي لعبة وابدأ الاختبار</p>
 </div>

 <div class="games">

  <div class="card" onclick="startGame('personality')">
   <div class="card-icon">🧠</div>
   <h3>اختبار الشخصية</h3>
   <p>اكتشف نوع شخصيتك من خلال مجموعة أسئلة سريعة.</p>
   <div class="play">ابدأ ←</div>
  </div>

  <div class="card" onclick="startGame('friend')">
   <div class="card-icon">👯</div>
   <h3>مين يعرف الثاني أكثر؟</h3>
   <p>تحدي ممتع لمعرفة مدى معرفتك بصديقك.</p>
   <div class="play">ابدأ ←</div>
  </div>

  <div class="card" onclick="startGame('similar')">
   <div class="card-icon">💜</div>
   <h3>هل أنتم متشابهين؟</h3>
   <p>جاوبوا على الأسئلة واكتشفوا نسبة التشابه.</p>
   <div class="play">ابدأ ←</div>
  </div>

  <div class="card" onclick="startGame('speed')">
   <div class="card-icon">⚡</div>
   <h3>سرعة البديهة</h3>
   <p>اختبر سرعة ردة فعلك وحاول تحطم رقمك.</p>
   <div class="play">ابدأ ←</div>
  </div>

  <div class="card" onclick="startGame('picture')">
   <div class="card-icon">🖼️</div>
   <h3>اختر صورة</h3>
   <p>اختر الصورة التي تجذبك وسنخبرك ماذا قد تعني.</p>
   <div class="play">ابدأ ←</div>
  </div>

  <div class="card" onclick="startGame('iq')">
   <div class="card-icon">🧩</div>
   <h3>كم مستوى ذكائك؟</h3>
   <p>اختبار سريع من أسئلة منطقية ممتعة.</p>
   <div class="play">ابدأ ←</div>
  </div>

  <div class="card" onclick="startGame('love')">
   <div class="card-icon">❤️</div>
   <h3>مقياس الحب</h3>
   <p>أدخل الاسمين واكتشف نسبة التوافق الترفيهية.</p>
   <div class="play">احسب ←</div>
  </div>

  <div class="card" onclick="startGame('height')">
   <div class="card-icon">📏</div>
   <h3>فرق الطول</h3>
   <p>مين أطول؟ وكم الفرق بينكما بالسنتيمتر؟</p>
   <div class="play">احسب ←</div>
  </div>

  <div class="card" onclick="startGame('friend2')">
   <div class="card-icon">⭐</div>
   <h3>كم تعرف عن صديقك؟</h3>
   <p>اختبار آخر للأصدقاء لمعرفة من يعرف الآخر أكثر.</p>
   <div class="play">ابدأ ←</div>
  </div>

 </div>
</main>

<section class="container" id="about">

 <div class="about">
  <h2>💜 عن Gaemhup</h2>
  <p>
   Gaemhup مساحة ترفيهية للاختبارات والألعاب الخفيفة.
   اختبر شخصيتك، تحدَّ أصدقاءك، اكتشف نسبة التوافق
   واستمتع بالنتائج وشاركها معهم.
  </p>
 </div>

</section>

<div class="ad">
 📢 مساحة إعلانية
</div>

<footer>
 © 2026 Gaemhup — جميع الحقوق محفوظة
</footer>

<div class="modal" id="modal">

 <div class="modal-box">

  <button class="close" onclick="closeGame()">×</button>

  <div id="gameContent"></div>

 </div>

</div>

<script>

const modal=document.getElementById("modal");
const content=document.getElementById("gameContent");

function openModal(html){
 content.innerHTML=html;
 modal.classList.add("active");
}

function closeGame(){
 modal.classList.remove("active");
}

modal.addEventListener("click",e=>{
 if(e.target===modal) closeGame();
});

document.addEventListener("keydown",e=>{
 if(e.key==="Escape") closeGame();
});


/* =========================
   اختبارات الأسئلة
========================= */

const quizzes={

 personality:{
  title:"🧠 اختبار الشخصية",
  questions:[
   {
    q:"عندما تكون في مكان مليء بالناس، ماذا تفعل؟",
    a:["أتعرف على أشخاص جدد","أفضل الهدوء والمراقبة","أكون مع الأشخاص المقربين"]
   },
   {
    q:"عندما تواجه مشكلة كبيرة؟",
    a:["أفكر فيها بهدوء","أطلب رأي شخص أثق به","أتصرف بسرعة وأجرب الحل"]
   },
   {
    q:"أي شيء يصفك أكثر؟",
    a:["مغامر","هادئ","اجتماعي"]
   },
   {
    q:"في وقت الفراغ تفضل؟",
    a:["تجربة شيء جديد","مشاهدة شيء ممتع","الخروج مع الأصدقاء"]
   }
  ]
 },

 friend:{
  title:"👯 مين يعرف الثاني أكثر؟",
  questions:[
   {
    q:"ما الشيء الذي يفرح صديقك أكثر؟",
    a:["الهدايا","الاهتمام","الخروج"]
   },
   {
    q:"إذا كان صديقك حزينًا ماذا يفعل؟",
    a:["يسكت","يتكلم","يختفي قليلًا"]
   },
   {
    q:"ما أكثر شيء يحبه صديقك؟",
    a:["المغامرات","الألعاب","الجلوس مع الأصدقاء"]
   },
   {
    q:"لو سافر فجأة، أين يذهب؟",
    a:["البحر","مدينة جديدة","مكان هادئ"]
   }
  ]
 },

 similar:{
  title:"💜 هل أنتم متشابهين؟",
  questions:[
   {
    q:"كيف تحبون قضاء الإجازة؟",
    a:["السفر","البيت","الخروج"]
   },
   {
    q:"ما الذي يجعلكم سعداء؟",
    a:["الأصدقاء","النجاح","المغامرة"]
   },
   {
    q:"كيف تتعاملون مع المشاكل؟",
    a:["نناقشها","نتجاهلها","نحلها بسرعة"]
   },
   {
    q:"اختاروا المشروب المفضل:",
    a:["قهوة","عصير","مشروب غازي"]
   }
  ]
 },

 iq:{
  title:"🧩 اختبار مستوى الذكاء",
  questions:[
   {
    q:"ما الرقم التالي؟ 2، 4، 8، 16، ؟",
    a:["24","32","36"],
    correct:1
   },
   {
    q:"إذا كان 5 + 5 × 2 = ؟",
    a:["20","15","10"],
    correct:1
   },
   {
    q:"أي كلمة مختلفة؟",
    a:["تفاحة","موز","سيارة"],
    correct:2
   },
   {
    q:"إذا تجاوزت الشخص الثاني في سباق، تصبح في المركز؟",
    a:["الأول","الثاني","الثالث"],
    correct:1
   },
   {
    q:"كم شهرًا يحتوي على 28 يومًا؟",
    a:["واحد","اثنان","كل الشهور"],
    correct:2
   }
  ]
 }

};


function startQuiz(type){

 const quiz=quizzes[type];

 let index=0;
 let score=0;

 function render(){

  const q=quiz.questions[index];

  const progress=((index)/quiz.questions.length)*100;

  content.innerHTML=`
   <h2 class="game-title">${quiz.title}</h2>

   <div class="progress">
    <span style="width:${progress}%"></span>
   </div>

   <div class="question">
    ${q.q}
   </div>

   <div class="options">
    ${q.a.map((x,i)=>`
     <button class="option" onclick="answer(${i})">${x}</button>
    `).join("")}
   </div>

   <div class="note">
    السؤال ${index+1} من ${quiz.questions.length}
   </div>
  `;

  window.answer=function(choice){

   if(type==="iq"){
    if(choice===q.correct) score++;
   }else{
    if(choice===0) score++;
   }

   index++;

   if(index>=quiz.questions.length){
    showResult(score,quiz.questions.length,type);
   }else{
    render();
   }

  };

 }

 render();
}


function showResult(score,total,type){

 let percent=Math.round((score/total)*100);

 let title="";
 let text="";
 let icon="✨";

 if(type==="iq"){

  if(percent>=80){
   title="ذكاء رائع! 🧠🔥";
   text="نتيجتك ممتازة! واضح أنك تحب التفكير وحل الألغاز.";
   icon="🏆";
  }else if(percent>=50){
   title="مستوى جيد! 🧠";
   text="عندك تفكير جيد، ومع المزيد من التحديات ممكن تحسن نتيجتك.";
   icon="✨";
  }else{
   title="نحتاج جولة ثانية 😄";
   text="لا تستسلم! جرب مرة ثانية وحاول تحطم نتيجتك.";
   icon="💪";
  }

 }else{

  if(percent>=75){
   title="نتيجة قوية! 💜";
   text="إجاباتك تدل على شخصية مميزة ومتوازنة.";
   icon="👑";
  }else if(percent>=50){
   title="نتيجة جميلة! ✨";
   text="واضح أن عندك جانبًا مميزًا في شخصيتك.";
   icon="💜";
  }else{
   title="نتيجة مختلفة! 😄";
   text="وهذا هو الشيء الجميل في الاختبارات، كل شخص له طابعه الخاص.";
   icon="🌟";
  }

 }

 content.innerHTML=`
  <div class="result">
   <div class="result-icon">${icon}</div>
   <h3>${title}</h3>

   <div class="percent">${percent}%</div>

   <p>${text}</p>

   <br>

   <button class="btn" onclick="closeGame()">تم ✨</button>
  </div>
 `;
}


/* =========================
   الصور
========================= */

function pictureGame(){

 openModal(`
  <h2 class="game-title">🖼️ اختر الصورة التي تجذبك</h2>

  <div class="options">

   <button class="option" onclick="pictureResult('🌙')">
    🌙 القمر
   </button>

   <button class="option" onclick="pictureResult('🌸')">
    🌸 الزهرة
   </button>

   <button class="option" onclick="pictureResult('🔥')">
    🔥 النار
   </button>

   <button class="option" onclick="pictureResult('🌊')">
    🌊 البحر
   </button>

  </div>

  <div class="note">
   الاختبار ترفيهي وليس تحليلًا علميًا للشخصية.
  </div>
 `);

}

function pictureResult(x){

 const results={
  "🌙":[
   "شخص هادئ وعميق 🌙",
   "تميل للتفكير قبل اتخاذ قراراتك، وتحب المساحة الخاصة بك."
  ],
  "🌸":[
   "شخص لطيف وحساس 🌸",
   "تهتم بالتفاصيل والمشاعر وتحب الأشياء الجميلة."
  ],
  "🔥":[
   "شخص قوي ومتحمس 🔥",
   "تحب التحديات ولا تخاف من تجربة الأشياء الجديدة."
  ],
  "🌊":[
   "شخص مرن وحر 🌊",
   "تحب الهدوء والحرية وتميل للتعامل مع الأمور ببساطة."
  ]
 };

 content.innerHTML=`
  <div class="result">
   <div class="result-icon">${x}</div>
   <h3>${results[x][0]}</h3>
   <p>${results[x][1]}</p>
   <br>
   <button class="btn" onclick="closeGame()">جميل 💜</button>
  </div>
 `;

}


/* =========================
   الحب
========================= */

function loveGame(){

 openModal(`
  <h2 class="game-title">❤️ مقياس الحب</h2>

  <div class="form-group">
   <label class="form-label">الاسم الأول</label>
   <input id="love1" placeholder="اكتب الاسم">
  </div>

  <div class="form-group">
   <label class="form-label">الاسم الثاني</label>
   <input id="love2" placeholder="اكتب الاسم">
  </div>

  <button class="btn" onclick="calculateLove()">
   احسب التوافق ❤️
  </button>

  <div class="note">
   النتيجة للترفيه فقط وليست مقياسًا علميًا.
  </div>
 `);

}

function calculateLove(){

 const a=document.getElementById("love1").value.trim();
 const b=document.getElementById("love2").value.trim();

 if(!a||!b){
  alert("اكتب الاسمين أولًا ❤️");
  return;
 }

 let total=0;

 for(const c of a+b){
  total+=c.charCodeAt(0);
 }

 const percent=40+(total%61);

 let message=
  percent>=85?"توافق خرافي! 🔥❤️":
  percent>=70?"بينكم انسجام جميل 💕":
  percent>=55?"فيه توافق لطيف ✨":
  "يمكن تحتاجون تعرفون بعض أكثر 😄";

 content.innerHTML=`
  <div class="result">
   <div class="result-icon">❤️</div>
   <h3>${a} + ${b}</h3>
   <div class="percent">${percent}%</div>
   <p>${message}</p>
   <br>
   <button class="btn" onclick="closeGame()">حلو 💜</button>
  </div>
 `;

}


/* =========================
   فرق الطول
========================= */

function heightGame(){

 openModal(`
  <h2 class="game-title">📏 فرق الطول</h2>

  <label class="form-label">طول الشخص الأول</label>
  <input id="height1" type="number" placeholder="مثال: 165">

  <label class="form-label">طول الشخص الثاني</label>
  <input id="height2" type="number" placeholder="مثال: 175">

  <button class="btn" onclick="calculateHeight()">
   احسب الفرق 📏
  </button>
 `);

}

function calculateHeight(){

 const a=Number(document.getElementById("height1").value);
 const b=Number(document.getElementById("height2").value);

 if(!a||!b||a<50||b<50){
  alert("اكتب أطوالًا صحيحة بالسنتيمتر");
  return;
 }

 const diff=Math.abs(a-b);

 let who=
  a>b?"الشخص الأول أطول 👑":
  b>a?"الشخص الثاني أطول 👑":
  "أنتم بنفس الطول تمامًا 😄";

 content.innerHTML=`
  <div class="result">
   <div class="result-icon">📏</div>
   <h3>${who}</h3>
   <div class="percent">${diff} سم</div>
   <p>فرق الطول بينكما هو ${diff} سم.</p>
   <br>
   <button class="btn" onclick="closeGame()">تم ✨</button>
  </div>
 `;

}


/* =========================
   سرعة البديهة
========================= */

let reactionTimer=null;
let reactionStart=0;

function speedGame(){

 openModal(`
  <h2 class="game-title">⚡ سرعة البديهة</h2>

  <p style="text-align:center;color:#b9abc5;margin-bottom:20px">
   انتظر حتى تتغير المنطقة إلى الأخضر، ثم اضغط بسرعة!
  </p>

  <div id="reaction" class="reaction-area" onclick="reactionClick()">
   انتظر... ⏳
  </div>

  <div id="speedResult"></div>
 `);

 setTimeout(()=>{

  const box=document.getElementById("reaction");

  if(!box)return;

  box.classList.add("ready");
  box.innerHTML="اضغط الآن! ⚡";
  reactionStart=performance.now();

 },1500+Math.random()*3000);

}

function reactionClick(){

 const box=document.getElementById("reaction");
 const result=document.getElementById("speedResult");

 if(!box)return;

 if(!box.classList.contains("ready")){

  box.innerHTML="بدري! 😭 انتظر الأخضر";

  return;
 }

 const time=Math.round(performance.now()-reactionStart);

 let msg=
  time<250?"سرعة خارقة! ⚡🔥":
  time<400?"ممتاز جدًا! 👏":
  time<600?"سرعة جيدة! 😎":
  "تحتاج تدريب أكثر 😄";

 result.innerHTML=`
  <div class="result">
   <div class="percent">${time}ms</div>
   <p>${msg}</p>
  </div>
 `;

 box.innerHTML="اضغط لإعادة الاختبار 🔄";
 box.classList.remove("ready");
 box.onclick=speedGame;

}


/* =========================
   تشغيل الألعاب
========================= */

function startGame(type){

 if(type==="love"){
  loveGame();
  return;
 }

 if(type==="height"){
  heightGame();
  return;
 }

 if(type==="picture"){
  pictureGame();
  return;
 }

 if(type==="speed"){
  speedGame();
  return;
 }

 if(type==="friend2"){
  startQuiz("friend");
  openModal(content.innerHTML);
  return;
 }

 startQuiz(type);

 openModal(content.innerHTML);
}

</script>

</body>
</html>
