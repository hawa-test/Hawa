<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GameHup - منصة الألعاب والاختبارات الترفيهية</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #6c5ce, #ff7675;
            --main-gradient: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);
            --secondary-gradient: linear-gradient(135deg, #fd79a8 0%, #e84393 100%);
            --dark: #2d3436;
            --light: #f5f6fa;
            --accent: #00b894;
            --card-bg: #ffffff;
            --shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: var(--light);
            color: var(--dark);
            line-height: 1.6;
        }

        /* رأس الصفحة */
        header {
            background: var(--main-gradient);
            color: white;
            padding: 2rem 1rem;
            text-align: center;
            box-shadow: var(--shadow);
        }

        header h1 {
            font-size: 2.8rem;
            font-weight: 900;
            margin-bottom: 0.5rem;
            letter-spacing: 1px;
        }

        header p {
            font-size: 1.1rem;
            opacity: 0.9;
        }

        /* شريط الإعلانات العُلوي */
        .ads-banner {
            max-width: 900px;
            margin: 20px auto;
            background: #e2e8f0;
            border: 2px dashed #cbd5e1;
            padding: 15px;
            text-align: center;
            color: #64748b;
            border-radius: 8px;
            font-size: 0.9rem;
        }

        /* تخطيط الموقع */
        .container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .section-title {
            font-size: 1.8rem;
            margin-bottom: 20px;
            color: var(--dark);
            border-right: 5px solid #6c5ce7;
            padding-right: 15px;
            font-weight: 700;
        }

        /* شبكة البطاقات */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 25px;
            margin-bottom: 50px;
        }

        .card {
            background: var(--card-bg);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border: 1px solid rgba(0,0,0,0.04);
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(108, 92, 231, 0.15);
        }

        .card-header {
            background: var(--secondary-gradient);
            color: white;
            padding: 20px;
            text-align: center;
            font-size: 1.3rem;
            font-weight: 700;
        }

        .card-body {
            padding: 20px;
            font-size: 0.95rem;
            color: #636e72;
            flex-grow: 1;
        }

        .card-footer {
            padding: 15px 20px;
            background: #fafafa;
            border-top: 1px solid #eee;
            text-align: center;
        }

        .btn {
            background: #6c5ce7;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-family: 'Cairo', sans-serif;
            transition: background 0.2s;
            width: 100%;
            text-decoration: none;
            display: inline-block;
        }

        .btn:hover {
            background: #5b47d6;
        }

        /* نافذة الاختبارات التفاعلية (Modal) */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(5px);
            justify-content: center;
            align-items: center;
            padding: 15px;
        }

        .modal-content {
            background: white;
            width: 100%;
            max-width: 650px;
            border-radius: 20px;
            padding: 30px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            position: relative;
            max-height: 90vh;
            overflow-y: auto;
        }

        .close-btn {
            position: absolute;
            left: 20px;
            top: 20px;
            font-size: 1.5rem;
            cursor: pointer;
            color: #b2bec3;
            font-weight: bold;
        }
        .close-btn:hover { color: var(--dark); }

        /* منطقة الألعاب الحية */
        .game-area {
            background: #1e293b;
            color: white;
            border-radius: 16px;
            padding: 30px;
            text-align: center;
            margin-bottom: 50px;
            box-shadow: var(--shadow);
        }

        canvas {
            background: #0f172a;
            border-radius: 8px;
            display: block;
            margin: 20px auto;
            border: 2px solid #334155;
            max-width: 100%;
        }

        /* تذييل الصفحة */
        footer {
            background: #2d3436;
            color: white;
            text-align: center;
            padding: 30px 20px;
            margin-top: 50px;
            font-
